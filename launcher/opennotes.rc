// Windows resource script for the OpenNotes launcher.
IDI_ICON1 ICON "../build/icon.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x4L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenNotes"
            VALUE "FileDescription", "OpenNotes launcher"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "opennotes-launcher"
            VALUE "OriginalFilename", "opennotes-launcher.exe"
            VALUE "ProductName", "OpenNotes"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
