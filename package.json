{
  "name": "opennotes",
  "version": "1.0.0",
  "description": "OpenNotes - an all-in-one text editor (Notepad + Notepad++)",
  "main": "./out/main/index.js",
  "author": "OpenNotes",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node node_modules/electron/install.js || exit 0",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --test tests/*.test.mts",
    "test:app": "node scripts/run-app-tests.mjs 1",
    "test:languages": "node scripts/run-app-tests.mjs 1 language-smoke.js",
    "test:stress": "node scripts/run-app-tests.mjs 1 stress-harness.js",
    "i18n:check": "node scripts/i18n.mjs check",
    "i18n:coverage": "node scripts/i18n.mjs coverage",
    "i18n:template": "node scripts/i18n.mjs template",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.{mjs,js}\" \"tests/*.mts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.{mjs,js}\" \"tests/*.mts\"",
    "check": "npm run format:check && npm run typecheck && npm run i18n:check && npm run test:unit && npm run build",
    "clean": "powershell -ExecutionPolicy Bypass -File scripts/clean.ps1",
    "launch": "node scripts/launch.mjs",
    "launcher:configure": "cmake -S . -B build-launcher -DCMAKE_BUILD_TYPE=Release",
    "launcher:build": "cmake --build build-launcher --config Release",
    "launcher:install": "cmake --install build-launcher --config Release",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:local": "electron-builder --win --publish never --config electron-builder.local.json"
  },
  "build": {
    "appId": "dev.opennotes.app",
    "productName": "OpenNotes",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/iconv-lite/**/*",
      "node_modules/safer-buffer/**/*"
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "removePackageScripts": true,
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "OpenNotes-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenNotes"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "fileAssociations": [
