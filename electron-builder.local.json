{
  "appId": "dev.opennotes.app",
  "productName": "OpenNotes",
  "icon": "build/icon.png",
  "directories": {
    "output": "release"
  },
  "files": [
    "out/**/*",
    "package.json",
    "node_modules/iconv-lite/**/*",
    "node_modules/safer-buffer/**/*"
  ],
  "asar": true,
  "compression": "maximum",
  "electronLanguages": [
    "en-US"
  ],
  "removePackageScripts": true,
  "npmRebuild": false,
  "win": {
    "target": [
      "nsis"
    ],
    "artifactName": "OpenNotes-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "OpenNotes"
  },
  "mac": {
    "target": [
      "dmg"
    ],
    "category": "public.app-category.productivity"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Utility"
  },
  "fileAssociations": [
    {
      "ext": "ts",
      "name": "TS File",
